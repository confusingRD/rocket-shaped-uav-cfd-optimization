FoamFile
{
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Production freestream specific dissipation rate: omega = 70 1/s.

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 70;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 70;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 70;
        value           uniform 70;
    }

    farfield_top
    {
        type            fixedValue;
        value           uniform 70;
    }

    rocket_wall
    {
        type            omegaWallFunction;
        value           uniform 70;
    }

    axis
    {
        type            symmetry;
    }

    wedge_front
    {
        type            wedge;
    }

    wedge_back
    {
        type            wedge;
    }
}

