FoamFile
{
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Initial turbulent kinematic viscosity based on k/omega.

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0.041285714;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0.041285714;
    }

    outlet
    {
        type            calculated;
        value           uniform 0.041285714;
    }

    farfield_top
    {
        type            calculated;
        value           uniform 0.041285714;
    }

    rocket_wall
    {
        type            nutkWallFunction;
        value           uniform 0;
    }

    axis
    {
        type            symmetry;
    }

    wedge_front
    {
        type            wedge;
    }

    wedge_back
    {
        type            wedge;
    }
}

