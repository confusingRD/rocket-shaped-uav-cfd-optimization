FoamFile
{
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Production freestream turbulent kinetic energy: k = 2.89 m^2/s^2.

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 2.89;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 2.89;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 2.89;
        value           uniform 2.89;
    }

    farfield_top
    {
        type            fixedValue;
        value           uniform 2.89;
    }

    rocket_wall
    {
        type            kqRWallFunction;
        value           uniform 2.89;
    }

    axis
    {
        type            symmetry;
    }

    wedge_front
    {
        type            wedge;
    }

    wedge_back
    {
        type            wedge;
    }
}

