Field[7].Ratio = 1.25000000;
Field[7].Thickness = 0.00874378;
Field[7].Quads = 1;
Field[7].PointsList = {bl_wall_points[]};
BoundaryLayer Field = 7;
Background Field = 5;

// --- Revolve into wedge volume ---
// Layers{1}+Recombine: single circumferential layer; meridional BL → wall-normal prisms/hexes
ext[] = Extrude{{1, 0, 0}, {0, 0, 0}, wedge_angle_rad}{
  Surface{rot[0]};
  Layers{1};
  Recombine;
};

// --- Post-extrusion physical groups ---
// ext[0]=wedge_back, ext[1]=fluid volume (Gmsh Extrude convention)
// Lateral BC surfaces: ext[] in meridional loop order (axis lines on r=0 omitted)
// Lateral surfaces span ext[2:] (6 sides)
inlet_surfs[] = {ext[7]};
outlet_surfs[] = {ext[5]};
farfield_top_surfs[] = {ext[6]};
rocket_wall_surfs[] = {ext[3]};
axis_surfs[] = {ext[2], ext[4]};

Physical Surface("wedge_back") = {ext[0]};
Physical Surface("inlet") = inlet_surfs[];
Physical Surface("outlet") = outlet_surfs[];
Physical Surface("farfield_top") = farfield_top_surfs[];
Physical Surface("rocket_wall") = rocket_wall_surfs[];
Physical Surface("axis") = axis_surfs[];
Physical Volume("fluid") = {ext[1]};

// --- Mesh options ---
Mesh.Algorithm = 8;
// 3D topology from Extrude Layers — no free tet fill of the wedge
